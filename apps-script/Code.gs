function getContractors_(){var s=sheets_(),x=rows_(s.contractors),cases=rows_(s.cases),out=[];for(var i=1;i<x.v.length;i++){var r=x.v[i],id=r[x.m['컨트랙터ID']],assigned=0,done=0,durations=[];for(var j=1;j<cases.v.length;j++)if(String(cases.v[j][cases.m['컨트랙터ID']])===String(id)){assigned++;if(['시공완료','정산완료'].indexOf(cases.v[j][cases.m['현재상태']])>=0){done++;var start=cases.v[j][cases.m['배정일시']],end=cases.v[j][cases.m['최종수정일시']];if(start instanceof Date&&end instanceof Date)durations.push(Math.round((end-start)/86400000));}}out.push({contractorId:id,name:r[x.m['이름']],phone:r[x.m['연락처']],accessCode:r[x.m['액세스코드']],contractStart:dateOnly_(r[x.m['계약시작일']]),contractLink:r[x.m['계약서Drive링크']],licenseCopyLink:r[x.m['라이선스사본링크']]||'',bondCopyLink:r[x.m['본드사본링크']]||'',businessProofLink:r[x.m['사업자증빙링크']]||'',unitPrice:r[x.m['건당단가']],active:r[x.m['활성여부']]==='예',licenseNumber:r[x.m['라이선스번호']]||'',licenseExpiry:dateOnly_(r[x.m['라이선스만료일']]),bondExpiry:dateOnly_(r[x.m['본드만료일']]),licenseVerified:r[x.m['라이선스수동확인여부']]==='예',identityMethod:r[x.m['본인확인방식']]||'',agreementAccepted:r[x.m['계약서동의여부']]==='예',assigned:assigned,completed:done,averageDays:durations.length?Math.round(durations.reduce(function(a,b){return a+b;},0)/durations.length):null});}return out;}
