function recordGovReimbursement(caseId,amount,date){return withLock_(function(){var c=findRow_(sheets_().cases,'CaseID',caseId);if(!c)throw Error('케이스를 찾을 수 없습니다.');var p=paymentRow_(caseId,c.data[c.m['컨트랙터ID']]),m=p.r.m;p.sh.getRange(p.r.row,m['정부정산수령액']+1,1,3).setValues([[Number(amount),date||new Date(),'완료']]);return {success:true};});}
function paymentCandidates_(){var s=sheets_(),x=rows_(s.cases),out=[],statuses=['대기','배정됨','방문예정','시공중','시공완료','서류제출완료','정산완료'],completedIndex=statuses.indexOf('시공완료');for(var i=1;i<x.v.length;i++){var r=x.v[i],status=String(r[x.m['현재상태']]||''),statusIndex=statuses.indexOf(status);if(statusIndex<completedIndex)continue;var pr=findRow_(s.payments,'CaseID',r[x.m.CaseID]);if(!pr||pr.data[pr.m['하청비지급상태']]!=='완료')out.push(caseObj_(r,x.m,[],{},false));}return out;}

