function assignCaseToContractor(caseId,contractorId){return withLock_(function(){var s=sheets_(),c=findRow_(s.cases,'CaseID',caseId),t=findRow_(s.contractors,'컨트랙터ID',contractorId),now=new Date();if(!c||!t||t.data[t.m['활성여부']]!=='예')throw Error('유효한 활성 업체와 케이스가 필요합니다.');var license=t.data[t.m['라이선스만료일']],bond=t.data[t.m['본드만료일']],identity=t.data[t.m['본인확인방식']];if((license instanceof Date&&license<now)||(bond instanceof Date&&bond<now))throw Error('라이선스 또는 본드가 만료된 업체입니다');if(['관리자수동확인완료','SMS인증','이메일인증'].indexOf(identity)<0)throw Error('본인확인이 완료되지 않은 업체입니다');var old=c.data[c.m['현재상태']];s.cases.getRange(c.row,c.m['컨트랙터ID']+1,1,2).setValues([[contractorId,now]]);s.cases.getRange(c.row,c.m['현재상태']+1).setValue('배정됨');s.cases.getRange(c.row,c.m['최종수정일시']+1).setValue(now);s.history.appendRow([caseId,now,old,'배정됨','컨트랙터 배정: '+t.data[t.m['이름']],'관리자']);return {success:true};});}
function getDashboardSummary(delayDays){var s=sheets_(),x=rows_(s.cases),h=rows_(s.history),limit=Number(delayDays||7),statuses=['대기','배정됨','시공중','시공완료','서류제출완료','정산완료'],counts={},delayed=[];statuses.forEach(function(k){counts[k]=0;});for(var i=1;i<x.v.length;i++){var r=x.v[i],state=r[x.m['현재상태']],updated=r[x.m['최종수정일시']],isDelayed=r[x.m['컨트랙터ID']]&&updated instanceof Date&&(new Date().getTime()-updated.getTime())/86400000>=limit&&['시공완료','정산완료'].indexOf(state)<0;counts[state]=(counts[state]||0)+1;if(isDelayed)delayed.push(caseObj_(r,x.m,h.v,h.m,false));}return {statusCounts:counts,contractors:getContractors_().map(function(c){return {name:c.name,assigned:c.assigned,completed:c.completed};}),delayed:delayed,delayDays:limit};}
function paymentRow_(caseId,contractorId){var sh=sheets_().payments,r=findRow_(sh,'CaseID',caseId);if(!r){sh.appendRow([caseId,contractorId||'',0,'','대기',0,'','대기']);r=findRow_(sh,'CaseID',caseId);}return {sh:sh,r:r};}
