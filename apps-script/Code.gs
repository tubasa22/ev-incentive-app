function doGet(e){try{var d={adminPassword:(e.parameter||{}).adminPassword||''};if(!admin_(d))return out_({success:false,error:'관리자 인증이 필요합니다.'});var q=String((e.parameter||{}).query||'').trim();if(!q)return out_({success:false,error:'CaseID 또는 전화번호가 필요합니다.'});return out_({success:true,cases:findCases_(q,true)});}catch(x){return out_({success:false,error:x.message});}}
function doPost(e){try{var d=JSON.parse((e.postData&&e.postData.contents)||'{}'),a=d.action;if(a==='createCase')return out_(createCase_(d));if(a==='adminLogin')return out_({success:admin_(d)});if(a==='contractorLogin')return out_({success:validateContractorLogin(d.contractorId,d.accessCode)});if(a==='getMyCases')return out_({success:true,cases:getCasesForContractor(d.contractorId,d.accessCode)});if(a==='updateMyCaseStatus')return out_(updateCaseStatusByContractor(d.caseId,d.contractorId,d.accessCode,d.newStatus,d.note));if(a==='sendOTP')return out_(sendContractOTP(d.contractorId,d.accessCode));if(a==='verifyOTP')return out_(verifyContractOTP(d.contractorId,d.accessCode,d.inputCode));if(a==='submitAgreement')return out_(submitContractorAgreement(d.contractorId,d.accessCode,d.data||{}));if(a==='getAgreementStatus')return out_({success:true,agreement:getContractorAgreementStatus(d.contractorId,d.accessCode)});if(a==='getCasesForContractor')return out_({success:true,cases:getCasesForContractor(d.contractorId,d.accessCode)});if(a==='updateStatus'){if(!authorizeStatus_(d))return out_({success:false,error:'상태 변경 권한이 없습니다.'});return out_(updateStatus_(d));}if(!admin_(d))return out_({success:false,error:'관리자 인증이 필요합니다.'});if(a==='confirmManualIdentity')return out_(confirmManualIdentity(d.contractorId));if(a==='markLicenseVerified')return out_(markLicenseVerified(d.contractorId));if(a==='registerContractor')return out_(registerContractor(d));if(a==='updateContractor')return out_(updateContractor(d.contractorId,d));if(a==='listContractors')return out_({success:true,contractors:getContractors_()});if(a==='getCases')return out_({success:true,cases:findCases_(d.query||'',true)});if(a==='getUnassignedCases')return out_({success:true,cases:getUnassignedCases()});if(a==='assignCase')return out_(assignCaseToContractor(d.caseId,d.contractorId));if(a==='dashboard')return out_({success:true,summary:getDashboardSummary(d.delayDays)});if(a==='subPayment')return out_(recordSubPayment(d.caseId,d.amount,d.date));if(a==='govReimbursement')return out_(recordGovReimbursement(d.caseId,d.amount,d.date));if(a==='paymentCandidates')return out_({success:true,cases:paymentCandidates_()});return out_({success:false,error:'지원하지 않는 요청입니다.'});}catch(x){return out_({success:false,error:x.message});}}
function out_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}function admin_(d){var p=PropertiesService.getScriptProperties().getProperty('ADMIN_PASSWORD');return !!p&&String(d.adminPassword||'')===p;}
function withLock_(fn){var lock=LockService.getScriptLock();try{lock.waitLock(10000);}catch(e){throw new Error('다른 작업이 진행 중입니다. 잠시 후 다시 시도해 주세요.');}try{return fn();}finally{lock.releaseLock();}}
function ensure_(name,headers){var ss=SpreadsheetApp.getActive(),sh=ss.getSheetByName(name);if(!sh){sh=ss.insertSheet(name);sh.appendRow(headers);sh.setFrozenRows(1);return sh;}var old=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getValues()[0];headers.forEach(function(h){if(old.indexOf(h)<0){sh.getRange(1,sh.getLastColumn()+1).setValue(h);old.push(h);}});return sh;}
function sheets_(){return {cases:ensure_('Cases',CASE_HEADERS),history:ensure_('StatusHistory',HISTORY_HEADERS),contractors:ensure_('Contractors',CONTRACTOR_HEADERS),payments:ensure_('Payments',PAYMENT_HEADERS)};}function map_(sh){var h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0],m={};h.forEach(function(x,i){m[x]=i;});return m;}function rows_(sh){var v=sh.getDataRange().getValues(),m={};v[0].forEach(function(x,i){m[x]=i;});return {v:v,m:m};}function json_(v,f){try{return JSON.parse(v);}catch(e){return f;}}function date_(v){return v instanceof Date?Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd HH:mm:ss'):String(v||'');}function findRow_(sh,col,value){var x=rows_(sh);for(var i=1;i<x.v.length;i++)if(String(x.v[i][x.m[col]])===String(value))return {row:i+1,data:x.v[i],m:x.m};return null;}

function createCase_(d){return withLock_(function(){if(!d.applicant||!d.applicant.name||!d.applicant.phone||!d.applicant.email)throw Error('이름, 전화번호, 이메일은 필수입니다.');var s=sheets_(),now=new Date(),id='EV-'+Utilities.formatDate(now,Session.getScriptTimeZone(),'yyyyMMdd-HHmmss')+'-'+Math.floor(100+Math.random()*900),m=map_(s.cases),row=[];for(var i=0;i<s.cases.getLastColumn();i++)row[i]='';row[m.CaseID]=id;row[m['생성일시']]=now;row[m['담당자']]=d.agent||'';row[m['신청자정보(JSON)']]=JSON.stringify(d.applicant);row[m['매칭프로그램목록(JSON)']]=JSON.stringify(d.programs||[]);row[m['현재상태']]='대기';row[m['최종수정일시']]=now;row[m['연락선호방법']]=d.contactPreference||d.applicant.contactPreference||'';row[m['매칭결과JSON']]=JSON.stringify(d.matchingResult||{});s.cases.appendRow(row);s.history.appendRow([id,now,'','대기','케이스 생성',d.agent||'']);return {success:true,caseId:id};});}
function authorizeStatus_(d){if(admin_(d))return true;if(!d.contractorId||!d.accessCode||!validateContractorLogin(d.contractorId,d.accessCode))return false;var r=findRow_(sheets_().cases,'CaseID',d.caseId);return !!r&&String(r.data[r.m['컨트랙터ID']])===String(d.contractorId);}
function updateStatus_(d){return withLock_(function(){return updateStatusUnlocked_(d);});}function updateStatusUnlocked_(d){var s=sheets_(),r=findRow_(s.cases,'CaseID',d.caseId);if(!r||!d.newStatus)throw Error('유효한 케이스와 상태가 필요합니다.');var old=r.data[r.m['현재상태']],now=new Date();if(old!==d.newStatus){s.cases.getRange(r.row,r.m['현재상태']+1).setValue(d.newStatus);s.cases.getRange(r.row,r.m['최종수정일시']+1).setValue(now);s.history.appendRow([d.caseId,now,old,d.newStatus,d.note||'',d.agent||'']);}return {success:true};}

function validateContractorLogin(contractorId,accessCode){if(!contractorId||!accessCode)return false;var r=findRow_(sheets_().contractors,'컨트랙터ID',contractorId);return !!r&&r.data[r.m['활성여부']]==='예'&&String(r.data[r.m['액세스코드']])===String(accessCode);}
function getCasesForContractor(contractorId,accessCode){if(!validateContractorLogin(contractorId,accessCode))throw Error('컨트랙터 인증에 실패했습니다.');var s=sheets_(),x=rows_(s.cases);return x.v.slice(1).filter(function(r){return String(r[x.m['컨트랙터ID']])===String(contractorId);}).map(function(r){return contractorCaseObj_(r,x.m);});}
function updateCaseStatusByContractor(caseId,contractorId,accessCode,newStatus,note){if(!validateContractorLogin(contractorId,accessCode))throw Error('컨트랙터 인증에 실패했습니다.');var s=sheets_(),r=findRow_(s.cases,'CaseID',caseId);if(!r||String(r.data[r.m['컨트랙터ID']])!==String(contractorId))throw Error('배정된 케이스만 변경할 수 있습니다.');var c=findRow_(s.contractors,'컨트랙터ID',contractorId);return updateStatus_({caseId:caseId,newStatus:newStatus,note:note||'',agent:c.data[c.m['이름']]});}
function isSmsEnabled_(){return PropertiesService.getScriptProperties().getProperty('FEATURES_SMS_ENABLED')==='true';}
function sendContractOTP(contractorId,accessCode){if(!validateContractorLogin(contractorId,accessCode))throw Error('컨트랙터 인증에 실패했습니다.');if(!isSmsEnabled_())return {success:true,smsDisabled:true};return withLock_(function(){var s=sheets_(),r=findRow_(s.contractors,'컨트랙터ID',contractorId),m=r.m,code=String(Math.floor(100000+Math.random()*900000)),p=PropertiesService.getScriptProperties(),sid=p.getProperty('TWILIO_SID'),token=p.getProperty('TWILIO_TOKEN'),from=p.getProperty('TWILIO_FROM');if(!sid||!token||!from)throw Error('SMS 설정이 완료되지 않았습니다. 관리자에게 문의하세요.');r=s.getRange(r.row,1,1,s.contractors.getLastColumn()).getValues()[0];s.contractors.getRange(findRow_(s.contractors,'컨트랙터ID',contractorId).row,m['OTP코드']+1,1,2).setValues([[code,new Date()]]);var response=UrlFetchApp.fetch('https://api.twilio.com/2010-04-01/Accounts/'+sid+'/Messages.json',{method:'post',payload:{To:r[m['연락처']],From:from,Body:'클린EV 계약서 인증번호: '+code+' (5분 내 유효)'},headers:{Authorization:'Basic '+Utilities.base64Encode(sid+':'+token)},muteHttpExceptions:true});if(response.getResponseCode()<200||response.getResponseCode()>=300)throw Error('인증번호 발송에 실패했습니다. 잠시 후 다시 시도해주세요.');return {success:true};});}
function verifyContractOTP(contractorId,accessCode,inputCode){if(!validateContractorLogin(contractorId,accessCode))throw Error('컨트랙터 인증에 실패했습니다.');if(!isSmsEnabled_())return {success:true,smsDisabled:true};return withLock_(function(){var s=sheets_(),r=findRow_(s.contractors,'컨트랙터ID',contractorId),m=r.m,issued=r.data[m['OTP발급시각']],valid=String(r.data[m['OTP코드']])===String(inputCode)&&issued instanceof Date&&(new Date()-issued)<=300000;s.contractors.getRange(r.row,m['OTP코드']+1,1,2).setValues([['','']]);if(!valid)throw Error('인증번호가 일치하지 않거나 만료되었습니다. 다시 요청해 주세요.');s.contractors.getRange(r.row,m['OTP검증시각']+1).setValue(new Date());return {success:true};});}
function submitContractorAgreement(contractorId,accessCode,data){if(!validateContractorLogin(contractorId,accessCode))throw Error('컨트랙터 인증에 실패했습니다.');return withLock_(function(){var s=sheets_(),r=findRow_(s.contractors,'컨트랙터ID',contractorId),m=r.m,now=new Date(),verified=r.data[m['OTP검증시각']];if(isSmsEnabled_()&&(!(verified instanceof Date)||(now-verified)>600000))throw Error('SMS 인증 후 10분 이내에 계약서를 제출해 주세요.');if(!data.signature||!data.agreed)throw Error('전자서명과 계약서 동의가 필요합니다.');var v={ '이름':data.businessName||r.data[m['이름']], '연락처':data.phone||r.data[m['연락처']], '라이선스번호':data.licenseNumber||'', '라이선스종류':data.licenseType||'', '라이선스만료일':data.licenseExpiry||'', '본드회사명':data.bondCompany||'', '본드번호':data.bondNumber||'', '본드보장금액':data.bondAmount||'', '본드만료일':data.bondExpiry||'', '계약서동의여부':'예', '계약서동의일시':now, '계약서버전':'v1.0', '본인확인방식':isSmsEnabled_()?'SMS인증':'관리자수동확인대기'};Object.keys(v).forEach(function(k){s.contractors.getRange(r.row,m[k]+1).setValue(v[k]);});return {success:true};});}
function getContractorAgreementStatus(contractorId,accessCode){if(!validateContractorLogin(contractorId,accessCode))throw Error('컨트랙터 인증에 실패했습니다.');var r=findRow_(sheets_().contractors,'컨트랙터ID',contractorId),m=r.m;return {completed:r.data[m['계약서동의여부']]==='예',licenseNumber:r.data[m['라이선스번호']]||'',licenseType:r.data[m['라이선스종류']]||'',licenseExpiry:date_(r.data[m['라이선스만료일']]),bondCompany:r.data[m['본드회사명']]||'',bondNumber:r.data[m['본드번호']]||'',bondExpiry:date_(r.data[m['본드만료일']]),identityMethod:r.data[m['본인확인방식']]||''};}
function confirmManualIdentity(contractorId){return withLock_(function(){var r=findRow_(sheets_().contractors,'컨트랙터ID',contractorId);if(!r)throw Error('업체를 찾을 수 없습니다.');r= findRow_(sheets_().contractors,'컨트랙터ID',contractorId);sheets_().contractors.getRange(r.row,r.m['본인확인방식']+1).setValue('관리자수동확인완료');return {success:true};});}
function markLicenseVerified(contractorId){return withLock_(function(){var s=sheets_(),r=findRow_(s.contractors,'컨트랙터ID',contractorId);if(!r)throw Error('업체를 찾을 수 없습니다.');s.contractors.getRange(r.row,r.m['라이선스수동확인여부']+1,1,2).setValues([['예',new Date()]]);return {success:true};});}
function contractorCaseObj_(r,m){var a=json_(r[m['신청자정보(JSON)']],{}),name=String(a.name||'');return {caseId:r[m.CaseID],name:name.length>1?name.slice(0,1)+'*':name,phone:a.phone||'',address:{zip:a.zip||'',housing:a.housing||''},workDetails:{purchaseType:a.purchaseType||'',desiredVehicle:a.desiredVehicle||''},status:r[m['현재상태']],assignedAt:date_(r[m['배정일시']]),updatedAt:date_(r[m['최종수정일시']])};}

function findCases_(q,includeMatching){var s=sheets_(),x=rows_(s.cases),h=rows_(s.history),needle=String(q).toLowerCase(),digits=needle.replace(/\D/g,''),out=[];for(var i=1;i<x.v.length;i++){var r=x.v[i],a=json_(r[x.m['신청자정보(JSON)']],{}),id=String(r[x.m.CaseID]);if(id.toLowerCase().indexOf(needle)<0&&(!digits||String(a.phone||'').replace(/\D/g,'').indexOf(digits)<0))continue;out.push(caseObj_(r,x.m,h.v,h.m,includeMatching));}return out;}
function caseObj_(r,m,hv,hm,includeMatching){var id=r[m.CaseID],hist=[];for(var j=1;j<hv.length;j++)if(String(hv[j][hm.CaseID])===String(id))hist.push({timestamp:date_(hv[j][hm['타임스탬프']]),previousStatus:hv[j][hm['이전상태']],newStatus:hv[j][hm['새상태']],note:hv[j][hm['메모']],agent:hv[j][hm['담당자']]});var o={caseId:id,createdAt:date_(r[m['생성일시']]),applicant:json_(r[m['신청자정보(JSON)']],{}),status:r[m['현재상태']],contractorId:r[m['컨트랙터ID']],assignedAt:date_(r[m['배정일시']]),updatedAt:date_(r[m['최종수정일시']]),history:hist};if(includeMatching){o.programs=json_(r[m['매칭프로그램목록(JSON)']],[]);o.matchingResult=json_(r[m['매칭결과JSON']],{});o.contactPreference=r[m['연락선호방법']]||'';}return o;}

function registerContractor(d){return withLock_(function(){var x=d.contractor||d;if(!x.name||!x.phone)throw Error('업체명과 연락처는 필수입니다.');var s=sheets_(),now=new Date(),id='CTR-'+Utilities.formatDate(now,Session.getScriptTimeZone(),'yyyyMMdd')+'-'+Math.floor(100+Math.random()*900),code=x.accessCode||Utilities.getUuid().slice(0,8).toUpperCase();s.contractors.appendRow([id,x.name,x.phone,code,x.contractStart||'',x.contractLink||'',Number(x.unitPrice||0),x.active===false?'아니오':'예',now,now]);return {success:true,contractorId:id,accessCode:code};});}
function updateContractor(id,d){return withLock_(function(){var r=findRow_(sheets_().contractors,'컨트랙터ID',id),x=d.contractor||d;if(!r)throw Error('업체를 찾을 수 없습니다.');var sh=sheets_().contractors,m=r.m;[['이름','name'],['연락처','phone'],['액세스코드','accessCode'],['계약시작일','contractStart'],['계약서Drive링크','contractLink'],['건당단가','unitPrice']].forEach(function(p){if(x[p[1]]!==undefined)sh.getRange(r.row,m[p[0]]+1).setValue(p[0]==='건당단가'?Number(x[p[1]]):x[p[1]]);});if(x.active!==undefined)sh.getRange(r.row,m['활성여부']+1).setValue(x.active?'예':'아니오');sh.getRange(r.row,m['최종수정일시']+1).setValue(new Date());return {success:true};});}
function getContractors_(){var s=sheets_(),x=rows_(s.contractors),cases=rows_(s.cases),out=[];for(var i=1;i<x.v.length;i++){var r=x.v[i],id=r[x.m['컨트랙터ID']],assigned=0,done=0,durations=[];for(var j=1;j<cases.v.length;j++)if(String(cases.v[j][cases.m['컨트랙터ID']])===String(id)){assigned++;if(['시공완료','정산완료'].indexOf(cases.v[j][cases.m['현재상태']])>=0){done++;var start=cases.v[j][cases.m['배정일시']],end=cases.v[j][cases.m['최종수정일시']];if(start instanceof Date&&end instanceof Date)durations.push(Math.round((end-start)/86400000));}}out.push({contractorId:id,name:r[x.m['이름']],phone:r[x.m['연락처']],accessCode:r[x.m['액세스코드']],contractStart:date_(r[x.m['계약시작일']]),contractLink:r[x.m['계약서Drive링크']],unitPrice:r[x.m['건당단가']],active:r[x.m['활성여부']]==='예',licenseNumber:r[x.m['라이선스번호']]||'',licenseExpiry:date_(r[x.m['라이선스만료일']]),bondExpiry:date_(r[x.m['본드만료일']]),licenseVerified:r[x.m['라이선스수동확인여부']]==='예',identityMethod:r[x.m['본인확인방식']]||'',assigned:assigned,completed:done,averageDays:durations.length?Math.round(durations.reduce(function(a,b){return a+b;},0)/durations.length):null});}return out;}
function getUnassignedCases(){var s=sheets_(),x=rows_(s.cases),h=rows_(s.history);return x.v.slice(1).filter(function(r){return !r[x.m['컨트랙터ID']];}).map(function(r){return caseObj_(r,x.m,h.v,h.m,false);});}
function assignCaseToContractor(caseId,contractorId){return withLock_(function(){var s=sheets_(),c=findRow_(s.cases,'CaseID',caseId),t=findRow_(s.contractors,'컨트랙터ID',contractorId),now=new Date();if(!c||!t||t.data[t.m['활성여부']]!=='예')throw Error('유효한 활성 업체와 케이스가 필요합니다.');var license=t.data[t.m['라이선스만료일']],bond=t.data[t.m['본드만료일']];if((license instanceof Date&&license<now)||(bond instanceof Date&&bond<now))throw Error('라이선스 또는 본드가 만료된 업체입니다');if(t.data[t.m['본인확인방식']]==='관리자수동확인대기')throw Error('본인확인이 완료되지 않은 업체입니다');var old=c.data[c.m['현재상태']];s.cases.getRange(c.row,c.m['컨트랙터ID']+1,1,2).setValues([[contractorId,now]]);s.cases.getRange(c.row,c.m['현재상태']+1).setValue('배정됨');s.cases.getRange(c.row,c.m['최종수정일시']+1).setValue(now);s.history.appendRow([caseId,now,old,'배정됨','컨트랙터 배정: '+t.data[t.m['이름']],'관리자']);return {success:true};});}
function getDashboardSummary(delayDays){var s=sheets_(),x=rows_(s.cases),h=rows_(s.history),limit=Number(delayDays||7),statuses=['대기','배정됨','시공중','시공완료','서류제출완료','정산완료'],counts={},delayed=[];statuses.forEach(function(k){counts[k]=0;});for(var i=1;i<x.v.length;i++){var r=x.v[i],state=r[x.m['현재상태']],updated=r[x.m['최종수정일시']],isDelayed=r[x.m['컨트랙터ID']]&&updated instanceof Date&&(new Date().getTime()-updated.getTime())/86400000>=limit&&['시공완료','정산완료'].indexOf(state)<0;counts[state]=(counts[state]||0)+1;if(isDelayed)delayed.push(caseObj_(r,x.m,h.v,h.m,false));}return {statusCounts:counts,contractors:getContractors_().map(function(c){return {name:c.name,assigned:c.assigned,completed:c.completed};}),delayed:delayed,delayDays:limit};}
function paymentRow_(caseId,contractorId){var sh=sheets_().payments,r=findRow_(sh,'CaseID',caseId);if(!r){sh.appendRow([caseId,contractorId||'',0,'','대기',0,'','대기']);r=findRow_(sh,'CaseID',caseId);}return {sh:sh,r:r};}
function recordSubPayment(caseId,amount,date){return withLock_(function(){var c=findRow_(sheets_().cases,'CaseID',caseId);if(!c)throw Error('케이스를 찾을 수 없습니다.');var p=paymentRow_(caseId,c.data[c.m['컨트랙터ID']]),m=p.r.m;p.sh.getRange(p.r.row,m['하청비지급액']+1,1,3).setValues([[Number(amount),date||new Date(),'완료']]);updateStatusUnlocked_({caseId:caseId,newStatus:'정산완료',note:'하청비 지급 처리',agent:'관리자'});return {success:true};});}
function recordGovReimbursement(caseId,amount,date){return withLock_(function(){var c=findRow_(sheets_().cases,'CaseID',caseId);if(!c)throw Error('케이스를 찾을 수 없습니다.');var p=paymentRow_(caseId,c.data[c.m['컨트랙터ID']]),m=p.r.m;p.sh.getRange(p.r.row,m['정부정산수령액']+1,1,3).setValues([[Number(amount),date||new Date(),'완료']]);return {success:true};});}
function paymentCandidates_(){var s=sheets_(),x=rows_(s.cases),pay=rows_(s.payments),out=[];for(var i=1;i<x.v.length;i++){var r=x.v[i];if(r[x.m['현재상태']]!=='시공완료')continue;var pr=findRow_(s.payments,'CaseID',r[x.m.CaseID]);if(!pr||pr.data[pr.m['하청비지급상태']]!=='완료')out.push(caseObj_(r,x.m,[],{},false));}return out;}
