var scriptLockHeld_=false;
function withLock_(fn){if(scriptLockHeld_)return fn();var lock=LockService.getScriptLock();try{lock.waitLock(10000);}catch(e){throw new Error('다른 작업이 진행 중입니다. 잠시 후 다시 시도해 주세요.');}scriptLockHeld_=true;try{return fn();}finally{scriptLockHeld_=false;lock.releaseLock();}}
function ensure_(name,headers){var ss=SpreadsheetApp.getActive(),sh=ss.getSheetByName(name);if(!sh){sh=ss.insertSheet(name);sh.appendRow(headers);sh.setFrozenRows(1);return sh;}var old=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getValues()[0];headers.forEach(function(h){if(old.indexOf(h)<0){sh.getRange(1,sh.getLastColumn()+1).setValue(h);old.push(h);}});return sh;}
function ensureAdmins_(){var sh=ensure_('Admins',ADMIN_HEADERS);if(sh.getLastRow()<=1){var legacy=PropertiesService.getScriptProperties().getProperty('ADMIN_PASSWORD');if(legacy)sh.appendRow(['ADM-001','대표님','',legacy,'예',new Date(),'']);}return sh;}function ensureProgramStatus_(){var sh=ensure_('ProgramStatus',PROGRAM_HEADERS);if(sh.getLastRow()<=1)PROGRAM_NAMES.forEach(function(n){sh.appendRow([n,'예',new Date(),'']);});return sh;}function sheets_(){return {cases:ensure_('Cases',CASE_HEADERS),history:ensure_('StatusHistory',HISTORY_HEADERS),contractors:ensure_('Contractors',CONTRACTOR_HEADERS),payments:ensure_('Payments',PAYMENT_HEADERS),applications:ensure_('ContractorApplications',APPLICATION_HEADERS),admins:ensureAdmins_(),dealers:ensure_('Dealers',DEALER_HEADERS),programStatus:ensureProgramStatus_(),leads:ensure_('Leads',LEAD_HEADERS)};}function map_(sh){var h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0],m={};h.forEach(function(x,i){m[x]=i;});return m;}function rows_(sh){var v=sh.getDataRange().getValues(),m={};v[0].forEach(function(x,i){m[x]=i;});return {v:v,m:m};}function json_(v,f){try{return JSON.parse(v);}catch(e){return f;}}function date_(v){return v instanceof Date?Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd HH:mm:ss'):String(v||'');}function dateOnly_(v){return v instanceof Date?Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd'):String(v||'');}function findRow_(sh,col,value){var x=rows_(sh);for(var i=1;i<x.v.length;i++)if(String(x.v[i][x.m[col]])===String(value))return {row:i+1,data:x.v[i],m:x.m};return null;}

function getProgramStatusDetails_(){var x=rows_(sheets_().programStatus),out=[];for(var i=1;i<x.v.length;i++)out.push({programName:x.v[i][x.m['프로그램명']],active:x.v[i][x.m['활성여부']]==='예',updatedAt:date_(x.v[i][x.m['마지막업데이트일시']]),memo:x.v[i][x.m['메모']]||''});return out;}function getProgramStatuses(){var x=rows_(sheets_().programStatus),out={};for(var i=1;i<x.v.length;i++)out[String(x.v[i][x.m['프로그램명']])]=String(x.v[i][x.m['활성여부']])==='예'?'예':'아니오';return out;}function updateProgramStatus(programName,active,memo){if(PROGRAM_NAMES.indexOf(programName)<0)throw Error('지원하지 않는 프로그램입니다.');return withLock_(function(){var s=sheets_().programStatus,r=findRow_(s,'프로그램명',programName),m=r&&r.m;if(!r)throw Error('프로그램 상태를 찾을 수 없습니다.');s.getRange(r.row,m['활성여부']+1,1,3).setValues([[active?'예':'아니오',new Date(),memo]]);return {success:true};});}
function listAdmins(d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');var x=rows_(ensureAdmins_()),out=[];for(var i=1;i<x.v.length;i++)out.push({adminId:x.v[i][x.m['관리자ID']],name:x.v[i][x.m['이름']],email:x.v[i][x.m['이메일']]||'',active:x.v[i][x.m['활성여부']]==='예',createdAt:date_(x.v[i][x.m['생성일시']]),lastLoginAt:date_(x.v[i][x.m['최종로그인일시']])});return out;}
function nextAdminId_(){var x=rows_(ensureAdmins_()),max=0;for(var i=1;i<x.v.length;i++){var n=Number(String(x.v[i][x.m['관리자ID']]||'').replace(/^ADM-/,''));if(isFinite(n))max=Math.max(max,n);}return 'ADM-'+String(max+1).padStart(3,'0');}
function registerAdmin(name,email,password,d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');name=String(name||'').trim();email=String(email||'').trim();password=String(password||'');if(!name||!email||!password)throw Error('이름, 이메일, 비밀번호는 필수입니다.');return withLock_(function(){var sh=ensureAdmins_(),id=nextAdminId_();sh.appendRow([id,name,email,password,'예',new Date(),'']);return {success:true,adminId:id};});}
function updateAdmin(adminId,data,d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');return withLock_(function(){var sh=ensureAdmins_(),r=findRow_(sh,'관리자ID',adminId);if(!r)throw Error('관리자 계정을 찾을 수 없습니다.');var m=r.m,map=[['이름','name'],['이메일','email'],['비밀번호','password']];map.forEach(function(p){if(data[p[1]]!==undefined&&String(data[p[1]]).trim())sh.getRange(r.row,m[p[0]]+1).setValue(String(data[p[1]]).trim());});if(data.active!==undefined)sh.getRange(r.row,m['활성여부']+1).setValue(data.active?'예':'아니오');return {success:true};});}
function dealerAmount_(value,allowZero){var n=Number(value);if(String(value===undefined?'':value).trim()===''||!isFinite(n)||n<0||(!allowZero&&n<=0)||n>999999999)throw Error('소개비 금액을 올바르게 입력해주세요.');return Math.round(n*100)/100;}
function getDealers(d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');var x=rows_(sheets_().dealers),out=[];for(var i=1;i<x.v.length;i++){var r=x.v[i];out.push({dealerId:r[x.m['딜러ID']],name:r[x.m['딜러명']],contactName:r[x.m['담당자명']],phone:r[x.m['연락처']],email:r[x.m['이메일']]||'',programs:r[x.m['참여프로그램']]||'',referralFee:Number(r[x.m['소개비금액']]||0),active:r[x.m['활성여부']]==='예',createdAt:date_(r[x.m['생성일시']]),updatedAt:date_(r[x.m['최종수정일시']])});}return out;}
function registerDealer(data,d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');data=data||{};var name=String(data.name||'').trim(),contactName=String(data.contactName||'').trim(),phone=String(data.phone||'').trim();if(!name||!contactName||!phone)throw Error('딜러명, 담당자명, 연락처는 필수입니다.');var fee=dealerAmount_(data.referralFee===undefined?0:data.referralFee,true);return withLock_(function(){var sh=sheets_().dealers,now=new Date(),id='DLR-'+Utilities.formatDate(now,Session.getScriptTimeZone(),'yyyyMMdd')+'-'+Math.floor(1000+Math.random()*9000);sh.appendRow([id,name,contactName,phone,String(data.email||'').trim(),String(data.programs||'').trim(),fee,data.active===false?'아니오':'예',now,now]);return {success:true,dealerId:id};});}
function updateDealer(dealerId,data,d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');data=data||{};return withLock_(function(){var sh=sheets_().dealers,r=findRow_(sh,'딜러ID',dealerId);if(!r)throw Error('딜러를 찾을 수 없습니다.');var m=r.m,merged={name:data.name===undefined?r.data[m['딜러명']]:String(data.name).trim(),contactName:data.contactName===undefined?r.data[m['담당자명']]:String(data.contactName).trim(),phone:data.phone===undefined?r.data[m['연락처']]:String(data.phone).trim()};if(!merged.name||!merged.contactName||!merged.phone)throw Error('딜러명, 담당자명, 연락처는 필수입니다.');var pairs=[['딜러명','name'],['담당자명','contactName'],['연락처','phone'],['이메일','email'],['참여프로그램','programs']];pairs.forEach(function(pair){if(data[pair[1]]!==undefined)sh.getRange(r.row,m[pair[0]]+1).setValue(String(data[pair[1]]).trim());});if(data.referralFee!==undefined)sh.getRange(r.row,m['소개비금액']+1).setValue(dealerAmount_(data.referralFee,true));if(data.active!==undefined)sh.getRange(r.row,m['활성여부']+1).setValue(data.active?'예':'아니오');sh.getRange(r.row,m['최종수정일시']+1).setValue(new Date());return {success:true};});}
function caseHasMyFirstEV_(r,m){var matching=json_(r[m['매칭결과JSON']],{}),programs=[];if(Array.isArray(matching.vehiclePrograms))programs=matching.vehiclePrograms;else if(Array.isArray(matching.results))programs=matching.results;else programs=json_(r[m['매칭프로그램목록(JSON)']],[]);return programs.some(function(p){return String((p&&p.id)||p)==='MyFirstEV'||String((p&&p.name)||'').toLowerCase().indexOf('my first ev')>=0;});}
function referCaseToDealer(caseId,dealerId,d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');return withLock_(function(){var s=sheets_(),c=findRow_(s.cases,'CaseID',caseId),dealer=findRow_(s.dealers,'딜러ID',dealerId),now=new Date();if(!c)throw Error('케이스를 찾을 수 없습니다.');if(!dealer||dealer.data[dealer.m['활성여부']]!=='예')throw Error('활성 제휴 딜러를 선택해주세요.');if(!caseHasMyFirstEV_(c.data,c.m))throw Error('MyFirstEV 매칭 케이스만 딜러에게 소개할 수 있습니다.');if(c.data[c.m['연계딜러ID']])throw Error('이미 딜러에게 소개된 케이스입니다.');c.data[c.m['연계딜러ID']]=dealerId;s.cases.getRange(c.row,c.m['연계딜러ID']+1).setValue(dealerId);s.cases.getRange(c.row,c.m['딜러소개일시']+1).setValue(now);s.cases.getRange(c.row,c.m['최종수정일시']+1).setValue(now);var status=c.data[c.m['현재상태']],dealerName=dealer.data[dealer.m['딜러명']];s.history.appendRow([caseId,now,status,status,'딜러소개: '+dealerName,getAdminName_(d)]);return {success:true,dealerId:dealerId,dealerName:dealerName,referredAt:date_(now)};});}
function recordDealerReferralFee(caseId,amount,date,d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');var fee=dealerAmount_(amount,false);return withLock_(function(){var sh=sheets_().cases,c=findRow_(sh,'CaseID',caseId);if(!c)throw Error('케이스를 찾을 수 없습니다.');if(!c.data[c.m['연계딜러ID']])throw Error('딜러 소개가 기록되지 않은 케이스입니다.');if(c.data[c.m['소개비수령여부']]==='예')throw Error('이미 소개비 수령 처리된 케이스입니다.');sh.getRange(c.row,c.m['소개비수령여부']+1,1,3).setValues([['예',fee,date||new Date()]]);sh.getRange(c.row,c.m['최종수정일시']+1).setValue(new Date());return {success:true};});}
function dealerReferralCandidates_(d){if(!admin_(d))throw Error('관리자 인증이 필요합니다.');var s=sheets_(),x=rows_(s.cases),dealers=rows_(s.dealers),out=[];for(var i=1;i<x.v.length;i++){var r=x.v[i],dealerId=r[x.m['연계딜러ID']];if(!dealerId||r[x.m['소개비수령여부']]==='예')continue;var dealer=null;for(var j=1;j<dealers.v.length;j++)if(String(dealers.v[j][dealers.m['딜러ID']])===String(dealerId)){dealer=dealers.v[j];break;}var applicant=json_(r[x.m['신청자정보(JSON)']],{});out.push({caseId:r[x.m.CaseID],applicantName:applicant.name||'',dealerId:dealerId,dealerName:dealer?dealer[dealers.m['딜러명']]:'확인 필요',referredAt:date_(r[x.m['딜러소개일시']]),expectedFee:dealer?Number(dealer[dealers.m['소개비금액']]||0):0});}return out;}
function createCase_(d){return withLock_(function(){if(!d.applicant||!d.applicant.name||!d.applicant.phone||!d.applicant.email)throw Error('이름, 전화번호, 이메일은 필수입니다.');var s=sheets_(),now=new Date(),id='EV-'+Utilities.formatDate(now,Session.getScriptTimeZone(),'yyyyMMdd-HHmmss')+'-'+Math.floor(100+Math.random()*900),m=map_(s.cases),row=[];for(var i=0;i<s.cases.getLastColumn();i++)row[i]='';row[m.CaseID]=id;row[m['생성일시']]=now;row[m['담당자']]=d.agent||'';row[m['신청자정보(JSON)']]=JSON.stringify(d.applicant);row[m['매칭프로그램목록(JSON)']]=JSON.stringify(d.programs||[]);row[m['현재상태']]='대기';row[m['최종수정일시']]=now;row[m['연락선호방법']]=d.contactPreference||d.applicant.contactPreference||'';row[m['매칭결과JSON']]=JSON.stringify(d.matchingResult||{});row[m['확인메일발송상태']]='대기';if(d.paymentConfirmed===true)row[m['결제일시']]=now;s.cases.appendRow(row);s.history.appendRow([id,now,'','대기','케이스 생성',d.agent||'']);return {success:true,caseId:id};});}
function processPendingConfirmationEmails(){return withLock_(function(){var s=sheets_(),x=rows_(s.cases),processed=0;for(var i=1;i<x.v.length;i++){var r=x.v[i],m=x.m;if(String(r[m['확인메일발송상태']]||'')!=='대기')continue;var caseId=r[m.CaseID],applicant=json_(r[m['신청자정보(JSON)']],{});try{sendConfirmationEmail_(applicant,caseId);s.cases.getRange(i+1,m['확인메일발송상태']+1).setValue('완료');Logger.log('접수 확인 이메일 발송 성공: CaseID='+caseId);}catch(e){s.cases.getRange(i+1,m['확인메일발송상태']+1).setValue('실패');Logger.log('접수 확인 이메일 발송 실패: CaseID='+caseId+', 오류='+String(e&&e.message||e));}processed++;}return {success:true,processed:processed};});}
